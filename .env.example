# Supabase API URL (http://127.0.0.1:54321 locally)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key for browser/server user clients
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role/secret key; allow-listed callers only (CLAUDE.md rule 1)
SUPABASE_SECRET_KEY=

# Direct Postgres URL for seed bulk functions and test setup
# (local: postgresql://postgres:postgres@127.0.0.1:54322/postgres)
SUPABASE_DB_URL=

# Absolute URL for links in notifications
APP_URL=

# Bearer token for /api/jobs/run
CRON_SECRET=

# "true" enables demo:reset
DEMO_RESET_ALLOWED=

# Password for seeded demo users (demo tenant only)
SEED_DEMO_PASSWORD=

# Default http://127.0.0.1:11434
OLLAMA_BASE_URL=

# Default qwen3:4b-instruct-2507-q4_K_M; fallback qwen2.5:3b
OLLAMA_MODEL=

# Global cloud switch, default "false"
AI_CLOUD_ENABLED=

# Optional; absent in the demo
ANTHROPIC_API_KEY=

# Defaults claude-sonnet-5 / claude-haiku-4-5
AI_CLOUD_MODEL_QUALITY=
AI_CLOUD_MODEL_CHEAP=

# "true" shows the demo account list on the login page (demo deployments only; DBT-11)
NEXT_PUBLIC_DEMO_LOGIN_HINTS=

# Set by entrypoints to "seed", "reset", or "jobs"; the admin client refuses otherwise
SERVICE_ROLE_CALLER=

# Cost assumptions for local inference (flagged in bench output)
BENCH_KWH_USD=
BENCH_HW_USD_PER_HOUR=
