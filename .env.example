# Supabase API URL (http://127.0.0.1:54321 locally)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key for browser/server user clients
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role/secret key; allow-listed callers only (CLAUDE.md rule 1)
SUPABASE_SECRET_KEY=

# Direct Postgres URL for seed bulk functions and test setup
# (local: postgresql://postgres:postgres@127.0.0.1:54322/postgres)
SUPABASE_DB_URL=

# Absolute URL for links in notifications
APP_URL=

# Bearer token for /api/jobs/run
CRON_SECRET=

# "true" enables demo:reset
DEMO_RESET_ALLOWED=

# Password for seeded demo users (demo tenant only)
SEED_DEMO_PASSWORD=

# Default http://127.0.0.1:11434
OLLAMA_BASE_URL=

# Default qwen3:4b-instruct-2507-q4_K_M; fallback qwen2.5:3b
OLLAMA_MODEL=

# Global cloud switch, default "false"
AI_CLOUD_ENABLED=

# Orb task bridge kill switch: "off" disables every orb task (approval cards)
AI_ORB_TASKS=

# Optional; absent in the demo
ANTHROPIC_API_KEY=

# Defaults claude-sonnet-5 / claude-haiku-4-5
AI_CLOUD_MODEL_QUALITY=
AI_CLOUD_MODEL_CHEAP=

# D28 — teacher tool-calling agent only (not the gateway above). Required for
# that feature; the agent is unavailable without it (no silent fallback —
# rule 7).
GEMINI_API_KEY=

# Default gemini-flash-lite-latest (D28: the flagship -flash tier's default
# reasoning budget made it ~100x slower on this free-tier key)
GEMINI_MODEL=

# D29 — teacher agent's routine-tier provider, routed by pickAgentProvider
# alongside Gemini above. Required for the agent's routine path; that path
# is unavailable without it (no silent fallback — rule 7).
GROQ_API_KEY=

# Default openai/gpt-oss-120b (D29: faster AND no worse than the smaller
# openai/gpt-oss-20b on this key; llama-3.x is not on this account's list)
GROQ_MODEL=

# "true" shows the demo account list on the login page (demo deployments only; DBT-11)
# Demo only: sign visitors in automatically as DEMO_AUTO_LOGIN_AS (a demo account email). Never enable on a real school.
DEMO_AUTO_LOGIN=
DEMO_AUTO_LOGIN_AS=
NEXT_PUBLIC_DEMO_LOGIN_HINTS=

# Set by entrypoints to "seed", "reset", or "jobs"; the admin client refuses otherwise
SERVICE_ROLE_CALLER=

# Cost assumptions for local inference (flagged in bench output)
BENCH_KWH_USD=
BENCH_HW_USD_PER_HOUR=

# local-only classifier bridge; default http://127.0.0.1:8787/predict
LAYA_BRIDGE_URL=

# M17/D42 — Resend email adapter. Unset = all email stays simulated.
RESEND_API_KEY=

# Optional sender; must be on a Resend-verified domain for real recipients.
# Default "CoolSkool <onboarding@resend.dev>" (Resend's test sender).
RESEND_FROM=

# X05/D42 — MSG91 WhatsApp adapter. Shared with a future SMS adapter.
MSG91_AUTH_KEY=

# MSG91 integrated WhatsApp number (digits with "91" prefix). Unset = simulated.
MSG91_WA_NUMBER=

# Optional WABA namespace for the approved templates.
MSG91_WA_NAMESPACE=

# M12 — Razorpay test-mode keys only (rzp_test_…). Unset/live = simulated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# M18 — Target Postgres URL for pnpm db:restore (fresh DB only; protects the shared local stack)
RESTORE_DB_URL=

# M18 — Exact hostname to allow a non-loopback restore target; missing blocks remote hosts
RESTORE_ALLOW_REMOTE_HOST=
