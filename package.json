{
  "name": "coolskool",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db --passWithNoTests",
    "test:security": "vitest run --project security --passWithNoTests",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && pnpm db:types && pnpm seed",
    "db:types": "supabase gen types typescript --local > src/lib/db/types.ts",
    "db:migration:new": "supabase migration new",
    "seed": "node --env-file-if-exists=.env.local scripts/seed/index.ts",
    "demo:reset": "node --env-file-if-exists=.env.local scripts/demo-reset.ts",
    "jobs:run": "echo \"not implemented (T-037)\" && exit 1",
    "ai:bench": "echo \"not implemented (T-040)\" && exit 1"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postgres": "^3.4.9",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.10.0"
}
