{
  "name": "coolskool",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db --passWithNoTests",
    "test:security": "vitest run --project security --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:narrative": "playwright test e2e/demo-narrative.spec.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && pnpm db:types && pnpm seed",
    "db:types": "supabase gen types typescript --local > src/lib/db/types.ts",
    "db:migration:new": "supabase migration new",
    "seed": "node --env-file-if-exists=.env.local scripts/seed/index.ts",
    "demo:reset": "node --env-file-if-exists=.env.local scripts/demo-reset.ts",
    "db:backup": "node --env-file-if-exists=.env.local scripts/db-backup.ts",
    "db:restore": "node --env-file-if-exists=.env.local scripts/db-restore.ts",
    "db:drill": "node --env-file-if-exists=.env.local scripts/db-drill.ts",
    "jobs:run": "node --env-file-if-exists=.env.local scripts/jobs-run.ts",
    "ai:bench": "node --env-file-if-exists=.env.local scripts/ai-bench/bench.ts",
    "load:l1": "node --env-file-if-exists=.env.local scripts/load/l1-attendance-burst.ts",
    "load:l2": "node --env-file-if-exists=.env.local scripts/load/l2-portal-results.ts",
    "load:l3": "node --env-file-if-exists=.env.local scripts/load/l3-bulk-invoices.ts",
    "load:l4": "node --env-file-if-exists=.env.local scripts/load/l4-public-site.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.90",
    "@ai-sdk/google": "^4.0.107",
    "@ai-sdk/groq": "^4.0.72",
    "@ai-sdk/react": "^4.0.160",
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@xyflow/react": "12.12.0",
    "ai": "7.0.155",
    "ai-sdk-ollama": "4.6.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.62.0",
    "motion": "^14.8.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autocannon": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postgres": "^3.4.9",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.10.0"
}
